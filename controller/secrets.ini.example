; Copy to secrets.ini (gitignored) and fill in.
; Use the same WiFi network the robot (UNO Q) is on.
; No quotes around values. Write % as %%. Don't use " \ $ or " ;" (space+semicolon):
; $ and " ;" silently truncate the value. Full guide: README.md -> "Creating secrets.ini".

[secrets]
wifi_ssid = YourNetwork
wifi_password = YourPassword
ota_password = change-me
